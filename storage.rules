rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile pictures ───────────────────────────────────────────────────
    // Any signed-in user can read any profile picture (needed to show other
    // group members' avatars). Only the owner can upload or delete their own.
    // Files are stored as profile_pictures/{uid}.jpg
    match /profile_pictures/{filename} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && filename == request.auth.uid + '.jpg';
      allow delete: if request.auth != null
                    && filename == request.auth.uid + '.jpg';
    }

  }
}
