rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── OTP requests ─────────────────────────────────────────────────────────
    // Written and validated exclusively by Cloud Functions via the Admin SDK.
    // Client apps must never read or write these documents directly.
    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Reads are open to any signed-in user so group-member lookups work.
    // Writes are owner-only. Email verification is NOT required here so the
    // Firestore profile can be written right after registration (before the
    // OTP verification step completes).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Notifications subcollection:
      //   - CREATE is blocked for all clients; only the dispatchNotification
      //     Cloud Function writes here via the Admin SDK (bypasses these rules).
      //   - Only the owner can read, mark as read, or delete their own.
      match /notifications/{notificationId} {
        allow create: if false;
        allow read, update, delete: if request.auth != null
            && request.auth.uid == userId;
      }
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    // All group operations require a verified email address. This blocks
    // access to financial data even if a user bypasses the client-side
    // EmailVerificationScreen gate.
    match /groups/{groupId} {
      allow read: if request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
          && request.auth.token.email_verified == true;

      allow update: if request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid in resource.data.members;

      allow delete: if request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid == resource.data.createdBy;

      // Expenses subcollection — group members with verified email only.
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
            && request.auth.token.email_verified == true
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      // Settlements subcollection — group members with verified email only.
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null
            && request.auth.token.email_verified == true
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
  }
}
